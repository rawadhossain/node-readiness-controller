    {
      "id": 12,
      "type": "row",
      "title": "Section 3 — Rule Bottleneck Ranking",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Slowest Rules by p99 Reaction Time",
      "description": "Top 5 slowest rules by p99 condition-change-to-taint-patch latency.",
      "datasource": {
        "type": "prometheus",
