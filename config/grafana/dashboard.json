    {
      "id": 16,
      "type": "timeseries",
      "title": "API Conflict Rate by Operation",
      "description": "Wave 2 metric — early warning signal that fires before failures_total does. No data until Wave 2 PR merges.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
