    {
      "id": 15,
      "type": "timeseries",
      "title": "Taint Operation Churn (Flapping Detection)",
      "description": "A rule with both add and remove rates elevated simultaneously indicates flapping — distinct from a rule that's simply slow or failing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (rule) (rate(node_readiness_taint_operations_total{operation=\"add\"}[5m]))",
          "legendFormat": "add {{rule}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (rule) (rate(node_readiness_taint_operations_total{operation=\"remove\"}[5m]))",
          "legendFormat": "remove {{rule}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
