      "title": "Bootstrap Completions Rate",
      "description": "Rate of successful bootstrap completions by rule.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
