        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "topk(5, histogram_quantile(0.99, sum by (le, rule) (rate(node_readiness_reconciliation_latency_seconds_bucket[10m])))) and on(rule) (sum by (rule) (rate(node_readiness_reconciliation_latency_seconds_count[10m])) > 0)",
