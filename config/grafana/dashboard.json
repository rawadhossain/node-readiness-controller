  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Managed Nodes",
      "description": "Counts node-rule evaluation pairs, not unique physical nodes — a node governed by N rules contributes N to this total. True per-node dedup isn't computable from current Prometheus metrics without adding per-node cardinality, which is avoided at scale. Headlamp, which reads the CR directly, is the source of truth for unique physical node counts.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(node_readiness_nodes_by_state)",
          "legendFormat": "Total Managed Nodes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "pluginVersion": "10.0.0"
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Nodes Blocked",
      "description": "Counts node-rule evaluation pairs in not_ready state, not unique physical nodes — a node blocked by N rules contributes N to this total. True per-node dedup isn't computable from current Prometheus metrics without adding per-node cardinality, which is avoided at scale. Headlamp, which reads the CR directly, is the source of truth for unique physical node counts.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(node_readiness_nodes_by_state{state=\"not_ready\"})",
          "legendFormat": "Nodes Blocked",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "pluginVersion": "10.0.0"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Bootstrapping Nodes",
      "description": "Counts node-rule evaluation pairs in bootstrapping state, not unique physical nodes — a node under N bootstrap-only rules contributes N to this total. True per-node dedup isn't computable from current Prometheus metrics without adding per-node cardinality, which is avoided at scale. Headlamp, which reads the CR directly, is the source of truth for unique physical node counts.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(node_readiness_nodes_by_state{state=\"bootstrapping\"})",
          "legendFormat": "Bootstrapping Nodes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "pluginVersion": "10.0.0"
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active Rules",
      "description": "Number of NodeReadinessRules currently tracked by the controller.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(node_readiness_rules_total)",
          "legendFormat": "Active Rules",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "pluginVersion": "10.0.0"
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Fleet Availability %",
      "description": "Ratio of ready node-rule pairs to total node-rule pairs — not unique physical nodes. A node governed by N rules where all N are satisfied contributes N ready pairs and N total pairs (100% for that node). A node with one unsatisfied rule out of N lowers this ratio proportionally. True per-node dedup isn't computable from current Prometheus metrics without adding per-node cardinality, which is avoided at scale. Headlamp, which reads the CR directly, is the source of truth for unique physical node counts.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 0 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * sum(node_readiness_nodes_by_state{state=\"ready\"}) / sum(node_readiness_nodes_by_state)",
          "legendFormat": "Fleet Availability %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "pluginVersion": "10.0.0"
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Error Budget Remaining %",
      "description": "SLO 3 error budget: 1 minus the ratio of failed taint operations (AddTaintError/RemoveTaintError) to total taint operation attempts, over a 5m window.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 0 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * (1 - (sum(rate(node_readiness_failures_total{reason=~\"AddTaintError|RemoveTaintError\"}[5m])) / (sum(rate(node_readiness_taint_operations_total[5m])) + sum(rate(node_readiness_failures_total{reason=~\"AddTaintError|RemoveTaintError\"}[5m])))))",
          "legendFormat": "Error Budget Remaining %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "N/A",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99 },
              { "color": "green", "value": 99.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "pluginVersion": "10.0.0"
    },
    {
      "id": 7,
      "type": "row",
      "title": "Section 2 — SLO 1: Bootstrap Latency",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": []
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Bootstrap Latency Percentiles",
      "description": "p50/p95/p99 bootstrap duration (node creation to bootstrap completion). Bootstrap-only rules only. Continuous-mode rules will show no data here.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.50, sum by (le, rule) (rate(node_readiness_bootstrap_duration_seconds_bucket[10m])))",
          "legendFormat": "p50 {{rule}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, rule) (rate(node_readiness_bootstrap_duration_seconds_bucket[10m])))",
          "legendFormat": "p95 {{rule}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, rule) (rate(node_readiness_bootstrap_duration_seconds_bucket[10m])))",
          "legendFormat": "p99 {{rule}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "pluginVersion": "10.0.0"
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Bootstrap Duration Distribution",
      "description": "p95 bootstrap duration trend per rule, with the 5-minute SLO target overlaid. Bootstrap-only rules only. Continuous-mode rules will show no data here.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, rule) (rate(node_readiness_bootstrap_duration_seconds_bucket[10m]))) and on(rule) (sum by (rule) (rate(node_readiness_bootstrap_duration_seconds_count[10m])) > 0)",
          "legendFormat": "p95 {{rule}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "pluginVersion": "10.0.0"
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Bootstrap Completion Errors",
      "description": "Rate of annotation-write failures in markBootstrapCompleted() by rule. Survivorship-bias alert: if this counter rises while bootstrap completions look healthy, nodes are silently getting stuck.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (rule) (rate(node_readiness_bootstrap_completion_errors_total[5m]))",
          "legendFormat": "{{rule}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "pluginVersion": "10.0.0"
    },
